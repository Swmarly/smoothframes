<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.2.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SmoothFrames</AssemblyName>
    <RootNamespace>SmoothFrames</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <EmbeddedResource Include="../../artifacts/native/x64/SmoothFramesHook.dll" LogicalName="Engine.x64.SmoothFramesHook.dll" />
    <EmbeddedResource Include="../../artifacts/native/x64/SmoothFramesInjector.exe" LogicalName="Engine.x64.SmoothFramesInjector.exe" />
    <EmbeddedResource Include="../../artifacts/native/x86/SmoothFramesHook.dll" LogicalName="Engine.x86.SmoothFramesHook.dll" />
    <EmbeddedResource Include="../../artifacts/native/x86/SmoothFramesInjector.exe" LogicalName="Engine.x86.SmoothFramesInjector.exe" />
  </ItemGroup>
  <Target Name="RequireNativeEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../artifacts/native/x64/SmoothFramesHook.dll') Or !Exists('../../artifacts/native/x86/SmoothFramesHook.dll') Or !Exists('../../artifacts/native/x64/SmoothFramesInjector.exe') Or !Exists('../../artifacts/native/x86/SmoothFramesInjector.exe')"
           Text="Build the bundled native engine first: pwsh ./scripts/build.ps1" />
  </Target>
</Project>
