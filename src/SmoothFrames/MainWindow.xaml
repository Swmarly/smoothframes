<Window x:Class="SmoothFrames.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmoothFrames.Controls"
        Title="SmoothFrames" Width="660" Height="490" MinWidth="610" MinHeight="470"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="7"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="*"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✦" FontSize="23" Foreground="{StaticResource Blue}" Margin="0,0,9,0"/>
                <TextBlock Text="SmoothFrames" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="EngineIndicator" Width="6" Height="6" Fill="{StaticResource Muted}"/>
                <TextBlock x:Name="EngineStatusText" Text="Built-in engine · ready" FontSize="11" Margin="7,0,0,0" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="GamePicker" Height="36" SelectionChanged="GamePicker_SelectionChanged"
                      AutomationProperties.Name="Game" ToolTip="Choose a running game or a saved executable"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="↻" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Padding="0" FontSize="19"
                    Click="RefreshGames_Click" ToolTip="Refresh running games" AutomationProperties.Name="Refresh games"/>
            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse…" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="BrowseGame_Click"/>
        </Grid>
        <TextBlock x:Name="SelectedGameStatus" Grid.Row="4" Text="Choose a running game, or browse to save a cap for later."
                   FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/><ColumnDefinition Width="73"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="9,4">
                <DockPanel>
                    <TextBlock Text="FPS" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBox x:Name="FpsInput" Text="120" MaxLength="4" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                             CaretBrush="{StaticResource Blue}" FontSize="17" VerticalContentAlignment="Center" TextChanged="FpsInput_TextChanged"
                             AutomationProperties.Name="Frame rate cap" ToolTip="Frame rate cap: 15 to 1000 FPS"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Content="30" Tag="30" Click="Preset_Click" Style="{StaticResource SmallButton}" Padding="7,5" ToolTip="30 FPS"/>
                <Button Content="60" Tag="60" Click="Preset_Click" Style="{StaticResource SmallButton}" Padding="7,5" Margin="4,0,0,0" ToolTip="60 FPS"/>
                <Button Content="120" Tag="120" Click="Preset_Click" Style="{StaticResource SmallButton}" Padding="7,5" Margin="4,0,0,0" ToolTip="120 FPS"/>
                <Button Content="144" Tag="144" Click="Preset_Click" Style="{StaticResource SmallButton}" Padding="7,5" Margin="4,0,0,0" ToolTip="144 FPS"/>
            </StackPanel>
            <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply cap" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="ApplyLimit_Click" Margin="6,0,0,0"/>
            <Button x:Name="PauseButton" Grid.Column="3" Content="Pause" Style="{StaticResource SmallButton}" Click="Pause_Click" Margin="6,0,0,0" ToolTip="Remove the active cap; keep your saved FPS value"/>
        </Grid>
        <Grid Grid.Row="8">
            <TextBlock x:Name="LiveMetricsText" Text="FPS —    Avg —    P99 —" FontSize="13" FontWeight="SemiBold"
                       ToolTip="Recent CPU-side Present intervals. These are not GPU render times or display latency."/>
            <TextBlock x:Name="TargetText" Text="8.33 ms target" HorizontalAlignment="Right" Foreground="{StaticResource Blue}" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Row="10" Background="#20242B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" MinHeight="110">
            <Grid>
                <controls:FrametimeGraph x:Name="FrameGraph" ClipToBounds="True"/>
                <TextBlock x:Name="EmptyGraphLabel" Text="Apply a cap to start monitoring" Margin="24" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Grid Grid.Row="12">
            <TextBlock Text="PRESENT INTERVAL · 45 s · sampled average" FontSize="9" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="DXGI · D3D9 · OpenGL" HorizontalAlignment="Right" FontSize="9" Foreground="{StaticResource Muted}"/>
        </Grid>
        <StackPanel Grid.Row="14">
            <TextBlock x:Name="StatusText" Text="Select a game and apply a cap. No additional tools needed." FontSize="11" TextWrapping="Wrap" MinHeight="30" Foreground="{StaticResource Text}"/>
            <TextBlock Text="Use with games that allow graphics hooks. Anti-cheat protected games may block attachment." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
