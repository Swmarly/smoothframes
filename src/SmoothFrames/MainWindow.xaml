 <Window x:Class="SmoothFrames.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmoothFrames" Width="740" Height="430" MinWidth="680" MinHeight="410"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource BlueWash}" Margin="0,0,11,0">
                    <TextBlock Text="K" Foreground="{StaticResource Blue}" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SmoothFrames" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Per-game FPS cap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12"
                    Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="RtssIndicator" Width="7" Height="7" Fill="#E2A848" VerticalAlignment="Center" />
                    <TextBlock x:Name="RtssStatusText" Text="Checking RTSS" FontSize="11"
                               Foreground="{StaticResource Muted}" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="GAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="1,0,0,7" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="GamePicker" Height="40" IsEditable="False" FontSize="13"
                          Foreground="{StaticResource Ink}" Background="White"
                          BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,7"
                          SelectionChanged="GamePicker_SelectionChanged" />
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource QuietButton}"
                        Click="RefreshGames_Click" Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="Browse…" Style="{StaticResource QuietButton}"
                        Click="BrowseGame_Click" Margin="8,0,0,0" />
            </Grid>
            <TextBlock x:Name="SelectedGamePath" Text="Select a running game or browse to its .exe"
                       FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                       Margin="2,6,0,0" />
        </StackPanel>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="12" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FPS cap" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Target interval" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FrameIntervalText" Text="8.33" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Blue}" Margin="8,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="ms / frame" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource FieldBg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="10,3" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock Text="FPS" Foreground="{StaticResource Muted}" FontSize="10"
                                       VerticalAlignment="Center" DockPanel.Dock="Right" Margin="8,0,0,0" />
                            <TextBox x:Name="FpsInput" Text="120" Width="48" Background="Transparent"
                                     BorderThickness="0" Foreground="{StaticResource Ink}" FontSize="17"
                                     FontWeight="SemiBold" VerticalContentAlignment="Center"
                                     TextChanged="FpsInput_TextChanged" />
                        </DockPanel>
                    </Border>
                    <Button Content="60" Tag="60" Style="{StaticResource PresetButton}" Click="Preset_Click" Margin="0,0,5,0" />
                    <Button Content="120" Tag="120" Style="{StaticResource PresetButton}" Click="Preset_Click" Margin="0,0,5,0" />
                    <Button Content="144" Tag="144" Style="{StaticResource PresetButton}" Click="Preset_Click" Margin="0,0,5,0" />
                    <Button Content="240" Tag="240" Style="{StaticResource PresetButton}" Click="Preset_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <TextBlock Text="RTSS applies the limit. Choose a cap your game can sustain."
                       FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Remove cap" Style="{StaticResource QuietButton}" Click="RemoveLimit_Click" Margin="0,0,8,0" />
                <Button Content="Apply limit" Style="{StaticResource PrimaryButton}" Click="ApplyLimit_Click" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="7"
                   Text="Ready. Select a game to configure its RTSS profile."
                   FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   Margin="1,10,1,0" />
    </Grid>
</Window>
